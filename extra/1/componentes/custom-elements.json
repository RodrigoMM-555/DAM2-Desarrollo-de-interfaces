            {
              "name": "esqueleto",
              "type": {
                "text": "boolean"
              },
              "default": "false",
              "description": "Dibuja el esqueleto virtual de cada mano.",
              "fieldName": "esqueleto"
            },
            {
              "name": "sin-rejilla",
              "type": {
                "text": "boolean"
              },
              "default": "false",
              "description": "No dibuja la zona de juego ni los carriles.",
              "fieldName": "sinRejilla"
            }
          ],
          "members": [
            {
              "kind": "field",
              "name": "esqueleto",
              "type": {
                "text": "boolean"
              },
              "description": "Dibuja el esqueleto virtual.",
              "default": "false"
            },
            {
              "kind": "field",
              "name": "sinRejilla",
              "type": {
                "text": "boolean"
              },
              "description": "Oculta la rejilla.",
              "default": "false"
            },
            {
              "kind": "field",
              "name": "video",
              "type": {
                "text": "HTMLVideoElement"
              },
              "description": "El <video> interno.",
              "readonly": true
            },
            {
              "kind": "method",
              "name": "dibujar",
              "description": "Pinta un fotograma.",
              "parameters": [
                {
                  "name": "detalle",
                  "type": {
                    "text": "DetalleFotograma | null"
                  }
                },
                {
                  "name": "zona",
                  "type": {
                    "text": "Rectangulo"
                  }
                }
              ]
            }
          ],
          "events": [
            {
              "name": "lista",
              "type": {
                "text": "CustomEvent<{ ancho: number, alto: number }>"
              },
              "description": "La cámara ya da imagen."
            }
          ],
          "cssProperties": [
            {
              "name": "--color-izquierda",
              "description": "Color de la mano izquierda."
            },
            {
              "name": "--color-derecha",
              "description": "Color de la mano derecha."
            }
          ]
        }
      ],
      "exports": [
        {
          "kind": "js",
          "name": "TbCamara",
          "declaration": {
            "name": "TbCamara",
