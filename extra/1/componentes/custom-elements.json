{
  "schemaVersion": "1.0.0",
  "readme": "README.md",
  "modules": [
    {
      "kind": "javascript-module",
      "path": "tb-pista.js",
      "declarations": [
        {
          "kind": "class",
          "name": "TbPista",
          "tagName": "tb-pista",
          "customElement": true,
          "description": "Pista de ritmo de 4 carriles dibujada en Canvas: notas con forma de mano, línea de juicio, manos del jugador y destellos.",
          "attributes": [
            {
              "name": "antelacion",
              "type": {
                "text": "number"
              },
              "default": "2",
              "description": "Segundos que tarda una nota en bajar.",
              "fieldName": "antelacion"
            },
            {
              "name": "transparente",
              "type": {
                "text": "boolean"
              },
              "default": "false",
              "description": "Carriles solo con bordes, para ir sobre la cámara.",
              "fieldName": "transparente"
            }
          ],
          "members": [
            {
              "kind": "field",
              "name": "antelacion",
              "type": {
                "text": "number"
              },
              "description": "Segundos que tarda una nota en bajar.",
              "default": "2"
            },
            {
              "kind": "field",
              "name": "transparente",
              "type": {
                "text": "boolean"
              },
              "description": "Carriles solo con bordes.",
              "default": "false"
            },
            {
              "kind": "field",
              "name": "notas",
              "type": {
                "text": "Nota[]"
              },
              "description": "Notas a dibujar.",
              "default": "[]"
            },
            {
              "kind": "field",
              "name": "pulso",
              "type": {
                "text": "number"
              },
              "description": "Segundos de un pulso (0 = sin líneas).",
              "default": "0"
            },
            {
              "kind": "field",
              "name": "geometria",
              "type": {
                "text": "{ x0: number, ancho: number, yLinea: number } | null"
              },
              "description": "Posición en píxeles; null = centrada.",
              "default": "null"
            },
            {
              "kind": "method",
              "name": "dibujar",
              "description": "Pinta el instante t de la canción.",
              "parameters": [
                {
                  "name": "t",
                  "type": {
                    "text": "number"
                  }
                },
                {
                  "name": "manos",
                  "type": {
                    "text": "EstadoManos"
                  }
                },
                {
                  "name": "puntos",
                  "type": {
                    "text": "PuntosManos | null"
                  }
                }
              ]
            },
            {
              "kind": "method",
              "name": "marcar",
              "description": "Muestra la calificación de una nota.",
              "parameters": [
                {
                  "name": "juicio",
                  "type": {
                    "text": "Juicio"
                  }
                }
              ]
            },
            {
              "kind": "method",
              "name": "reiniciar",
              "description": "Olvida notas acertadas y efectos.",
              "parameters": []
            }
          ],
          "events": [
            {
              "name": "marcada",
              "type": {
                "text": "CustomEvent<{ juicio: Juicio }>"
              },
              "description": "Se ha mostrado una calificación."
            }
          ],
          "cssProperties": [
            {
              "name": "--color-izquierda",
              "description": "Color de la mano izquierda."
            },
            {
              "name": "--color-derecha",
              "description": "Color de la mano derecha."
            },
            {
              "name": "--color-texto",
              "description": "Color del texto."
            },
            {
              "name": "--color-fondo",
              "description": "Color de fondo (letra de las manos)."
            }
          ]
        }
      ],
      "exports": [
        {
          "kind": "js",
          "name": "TbPista",
          "declaration": {
            "name": "TbPista",
            "module": "tb-pista.js"
          }
        },
        {
          "kind": "custom-element-definition",
          "name": "tb-pista",
          "declaration": {
            "name": "TbPista",
            "module": "tb-pista.js"
          }
        }
      ]
    },
    {
      "kind": "javascript-module",
      "path": "tb-camara.js",
      "declarations": [
        {
          "kind": "class",
